{
  "$meta": {
    "name": "Maintain Mining Design Tokens",
    "version": "2 — graphite",
    "sources": [
      "user-pinned grayish black #303234 (48, 50, 52) as the brand colour",
      "the two-tone language of the heavy-machinery world (Komatsu / Caterpillar): graphite fleet + equipment-safety yellow"
    ],
    "reference": "./index.html",
    "note": "Build against `semantic` roles, not raw brand values. Graphite #303234 is the one flat brand value and the logo colour on light; the logo inverts to white on dark (graphite is 1.2:1 there). Safety amber #FFB800 is the single working accent — primary actions, hazard highlights, keylines — and carries only pit-black ink. Brand imagery is desaturated charcoal wireframe terrain.",
    "spec": "../DESIGN.md"
  },
  "brand": {
    "graphite": "#303234",
    "amber": "#FFB800",
    "black": "#131416",
    "black-2": "#0E0F10",
    "black-3": "#1C1E20",
    "shaft": "#26282B",
    "steel": "#9AA1A8",
    "steel-bright": "#C4CAD0",
    "steel-deep": "#5F6570",
    "gray-tint-1": "#F1F2F3",
    "gray-tint-2": "#E4E6E8",
    "amber-tint": "#FFF1CC",
    "cloud": "#F5F4F1",
    "white": "#FFFFFF",
    "ink": "#26282B",
    "slate": "#5C6670",
    "surface-gray-1": "#F8F9F9",
    "surface-gray-2": "#F1F2F3"
  },
  "gradient": {
    "css": "linear-gradient(115deg, #131416 0%, #303234 52%, #5F6570 100%)",
    "note": "The seam ramp: charcoal -> graphite -> steel. Light surfaces only — the charcoal start vanishes on dark grounds."
  },
  "semantic": {
    "bg": "shaft",
    "bg-deep": "black",
    "surface": "white",
    "surface-soft": "cloud",
    "text": "ink",
    "text-muted": "slate",
    "primary": "amber",
    "primary-ink": "black",
    "accent": "graphite",
    "highlight": "amber",
    "highlight-ink": "black",
    "gradient": "gradient.css",
    "on-dark": "#FFFFFF",
    "on-dark-muted": "rgba(255,255,255,0.72)",
    "on-dark-faint": "rgba(255,255,255,0.55)"
  },
  "contrast": {
    "$note": "WCAG 2.2 ratios, computed. AA body >= 4.5, AA large/graphics >= 3.0.",
    "amber on shaft": 8.52,
    "amber on black": 10.63,
    "black on amber": 10.63,
    "white on shaft": 14.78,
    "white on graphite": 12.87,
    "graphite on white": 12.87,
    "graphite on cloud": 11.7,
    "graphite on shaft (NEVER — logo inverts to white on dark)": 1.15,
    "steel on shaft": 5.66,
    "steel-bright on shaft": 8.94,
    "steel-deep on white": 5.86,
    "slate on white": 5.85,
    "ink on white": 14.78
  },
  "severity": {
    "$note": "Functional traffic-light semantics — deliberately not rebranded.",
    "pass": { "fg": "#0C4A26", "bg": "#E5F8EE" },
    "low": { "fg": "#1E40AF", "bg": "#DBEAFE" },
    "medium": { "fg": "#854D0E", "bg": "#FEF9C3" },
    "high": { "fg": "#9A3412", "bg": "#FFEDD5" },
    "critical": { "fg": "#991B1B", "bg": "#FEE2E2" }
  },
  "typography": {
    "display": "Albert Sans",
    "body": "Inter",
    "social-alt": "Vela Sans",
    "tracking": { "display": "-0.02em", "tight": "-0.01em" },
    "leading": { "display": 1.05, "body": 1.6 },
    "scale": {
      "display": "clamp(2.75rem,6vw,4.5rem)",
      "h1": "clamp(2rem,4vw,3rem)",
      "h2": "clamp(1.5rem,3vw,2rem)",
      "h3": "1.375rem",
      "h4": "1.125rem",
      "body-lg": "1.125rem",
      "body": "1rem",
      "sm": "0.875rem",
      "xs": "0.75rem",
      "overline": "0.6875rem"
    },
    "weights": { "display": [700, 800], "body": [400, 500, 600] }
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px",
    "6": "32px", "7": "48px", "8": "64px", "9": "96px", "10": "128px"
  },
  "radius": {
    "sharp": "0", "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px", "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(14,15,16,.08)",
